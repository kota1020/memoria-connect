  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./observe": "./src/observe.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "memoria": "bin/memoria.mjs"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "README.md",
